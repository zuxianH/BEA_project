Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"YQa", "[", 
     RowBox[{"a_", ",", "s_", ",", "YD_"}], "]"}], ":=", 
    RowBox[{
     SuperscriptBox["u", 
      RowBox[{"MM", "[", 
       RowBox[{"a", ",", "s", ",", "YD"}], "]"}]], "+", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"c", "[", 
         RowBox[{"a", ",", "s", ",", "k"}], "]"}], 
        SuperscriptBox["u", 
         RowBox[{
          RowBox[{"MM", "[", 
           RowBox[{"a", ",", "s", ",", "YD"}], "]"}], "-", "k"}]]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"MM", "[", 
          RowBox[{"a", ",", "s", ",", "YD"}], "]"}]}], "}"}]}], "]"}]}]}], 
   ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Gives", " ", "roots", " ", "from", " ", "centres", " ", "of", " ", 
    "strings", " ", "symbolically"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"BetheRootsFromStrings", "[", "stringconfig_", "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"vargroups", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"x", "[", 
            RowBox[{"a", ",", "#"}], "]"}], "&"}], ",", 
          RowBox[{"TakeList", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"Total", "[", 
              RowBox[{"stringconfig", "[", 
               RowBox[{"[", "a", "]"}], "]"}], "]"}], "]"}], ",", 
            RowBox[{"stringconfig", "[", 
             RowBox[{"[", "a", "]"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", 
          RowBox[{
           RowBox[{"Length", "[", "stringconfig", "]"}], "-", "1"}]}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"orgvargroups", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"GatherBy", "[", 
         RowBox[{"#", ",", "Length"}], "]"}], "&"}], "/@", "vargroups"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"stringToXroots", "=", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"k", "=", 
              RowBox[{
               RowBox[{
                RowBox[{"Position", "[", 
                 RowBox[{
                  RowBox[{"orgvargroups", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "j", ",", "m"}], "]"}], "]"}], ",", 
                  "#"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}], "-", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Length", "[", 
                   RowBox[{"orgvargroups", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j", ",", "m"}], "]"}], "]"}], "]"}], "-",
                   "1"}], ")"}], "/", "2"}], "-", "1"}]}], ";", 
             RowBox[{"#", "/.", 
              RowBox[{
               RowBox[{"x", "[", 
                RowBox[{"a_", ",", "n_"}], "]"}], ":>", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"x", "[", 
                  RowBox[{"a", ",", "n"}], "]"}], "->", 
                 RowBox[{
                  RowBox[{"v", "[", 
                   RowBox[{"i", ",", 
                    RowBox[{"Length", "[", 
                    RowBox[{"orgvargroups", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j", ",", "1"}], "]"}], "]"}], "]"}], ",",
                     "m"}], "]"}], "-", 
                  RowBox[{"k", " ", "I"}]}]}], ")"}]}]}]}], ")"}], "&"}], "/@", 
          RowBox[{"orgvargroups", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j", ",", "m"}], "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "orgvargroups", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"Length", "[", 
            RowBox[{"orgvargroups", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"Length", "[", 
            RowBox[{"orgvargroups", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}]}], "}"}]}], "]"}], 
       "//", "Flatten"}]}]}], ")"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Gives", " ", "roots", " ", "from", " ", "c", " ", "coefficients", " ", 
    "numerically"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rootsfromcoeff", "[", 
    RowBox[{"YD_", ",", "sol_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "k", "}"}], ",", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a", ",", "s"}], "}"}], "!=", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}]}], ",", 
          RowBox[{
           RowBox[{"k", "=", "1"}], ";", 
           RowBox[{
            RowBox[{
             RowBox[{"ReplaceAll", "[", 
              RowBox[{"#", ",", 
               RowBox[{"u", "->", 
                RowBox[{"x", "[", 
                 RowBox[{"a", ",", "s", ",", 
                  RowBox[{"k", "++"}]}], "]"}]}]}], "]"}], "&"}], "/@", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"NSolve", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"YQa", "[", 
                  RowBox[{"a", ",", "s", ",", "YD"}], "]"}], "/.", "sol"}], ",",
                 "u"}], "]"}], "//", "Flatten"}], ")"}]}]}], ",", "Nothing"}],
          "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", "0", ",", 
          RowBox[{
           RowBox[{"Length", "[", "YD", "]"}], "-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "0", ",", 
          RowBox[{
           RowBox[{"YD", "[", 
            RowBox[{"[", 
             RowBox[{"a", "+", "1"}], "]"}], "]"}], "-", "1"}]}], "}"}]}], 
       "]"}], "//", "Flatten"}]}], "]"}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9773017730808287`*^9, 3.977301796074217*^9}, {
  3.977638925301612*^9, 3.977638949552644*^9}, {3.9776407527858133`*^9, 
  3.977640755265648*^9}, {3.9776408012337914`*^9, 3.9776408105507603`*^9}},
 CellLabel->
  "In[1242]:=",ExpressionUUID->"9a49772c-7f17-41c1-9d78-e53cb1c67b41"],

