Cell[CellGroupData[{

Cell["Mode numbers for exact strings", "Subsection",
 CellChangeTimes->{{3.977300855331127*^9, 
  3.977300857960737*^9}},ExpressionUUID->"11b877e8-b396-4775-af74-\
a1b45b4016d0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Function", " ", "that", " ", "takes", " ", "a", " ", "set", " ", "of", " ",
     "roots", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"x", "[", 
        RowBox[{"1", ",", "0", ",", "1"}], "]"}], "->", "a1"}], ",", 
      RowBox[{
       RowBox[{"x", "[", 
        RowBox[{"1", ",", "0", ",", "2"}], "]"}], "->", "a2"}], ",", "...", ",", 
      RowBox[{
       RowBox[{"x", "[", 
        RowBox[{"N", ",", "0", ",", "p"}], "]"}], "->", "aq"}]}], "}"}], " ", 
    "and", " ", "produces", " ", "a", " ", "nested", " ", "list", " ", 
    "where", " ", "the", " ", "first", " ", "nested", " ", "level", " ", 
    "corresponds", " ", "to", " ", "the", " ", "nesting", " ", "of", " ", 
    "the", " ", "BAE", " ", "and", " ", "the", " ", "second", " ", 
    "corresponds", " ", "to", " ", "strings", " ", "within", " ", "this", " ",
     "nested", " ", "level"}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "There", " ", "is", " ", "no", " ", "algorithm", " ", "to", " ", "check", " ",
     "if", " ", "there", " ", "are", " ", "several", " ", "ways", " ", "to", " ",
     "make", " ", "strings", " ", "that", " ", "look", " ", "more", " ", "or",
     " ", "less", " ", "equally", " ", 
    RowBox[{"good", ".", " ", "This"}], " ", "must", " ", "be", " ", "done", " ",
     "by", " ", 
    RowBox[{"hand", "."}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"StringSorter", "[", "rootsExact_", "]"}], ":=", 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"d\[Delta]", "=", "0.3"}], ";", "\[IndentingNewLine]", 
      RowBox[{"allLevelstrings", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"rootvals", "=", 
          RowBox[{
           RowBox[{"rootsExact", "/.", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"x", "[", 
                RowBox[{"a_", ",", "0", ",", "b_"}], "]"}], "->", "n_"}], 
              ")"}], ":>", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"a", "==", "i"}], ",", 
               RowBox[{
                RowBox[{"x", "[", 
                 RowBox[{"a", ",", "0", ",", "b"}], "]"}], "->", "n"}], ",", 
               "Nothing"}], "]"}]}]}], "//", "Values"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"strings", "=", 
          RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"While", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "rootvals", "]"}], ">", "0"}], ",", 
           RowBox[{
            RowBox[{"string", "=", 
             RowBox[{"{", 
              RowBox[{"Extract", "[", 
               RowBox[{"rootvals", ",", 
                RowBox[{
                 RowBox[{"PositionLargest", "[", 
                  RowBox[{"rootvals", "//", "Im"}], "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "}"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"stringlength", "=", 
             RowBox[{"Min", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"2", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"string", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "//", "Im"}], "//", 
                    RowBox[{
                    RowBox[{"Round", "[", 
                    RowBox[{"#", ",", "0.1"}], "]"}], "&"}]}], ")"}]}], "+", 
                 "1"}], "//", "Round"}], ",", 
               RowBox[{"Length", "[", "rootvals", "]"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"Do", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"step0", "=", 
                RowBox[{"string", "[", 
                 RowBox[{"[", 
                  RowBox[{"-", "1"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"step1", "=", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"step0", "//", "Im"}], ")"}], "-", "1"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"step2", "=", 
                RowBox[{"Select", "[", 
                 RowBox[{"rootvals", ",", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"step1", "-", "d\[Delta]"}], "<", 
                    RowBox[{"(", 
                    RowBox[{"#", "//", "Im"}], ")"}], "<", 
                    RowBox[{"step1", "+", "d\[Delta]"}]}], "&"}]}], "]"}]}], ";",
                "\[IndentingNewLine]", 
               RowBox[{"step3", "=", 
                RowBox[{
                 RowBox[{"PositionSmallest", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"#", "-", "step0"}], "//", "Re"}], "]"}], "&"}], "/@",
                    "step2"}], "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"step4", "=", 
                RowBox[{"Extract", "[", 
                 RowBox[{"step2", ",", "step3"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"string", ",", "step4"}], "]"}], ";"}], ",", 
              RowBox[{
               RowBox[{"Ceiling", "[", 
                RowBox[{"stringlength", "/", "2"}], "]"}], "-", "1"}]}], 
             "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"Do", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"step5", "=", 
                RowBox[{"Extract", "[", 
                 RowBox[{"rootvals", ",", 
                  RowBox[{"PositionSmallest", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"#", "-", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"string", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "//", "Conjugate"}], 
                    ")"}]}], "]"}], "&"}], "/@", "rootvals"}], "]"}]}], 
                 "]"}]}], ";", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"string", ",", "step5"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", 
                RowBox[{"Floor", "[", 
                 RowBox[{"stringlength", "/", "2"}], "]"}]}], "}"}]}], "]"}], 
            ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"strings", ",", 
              RowBox[{"string", "//", 
               RowBox[{
                RowBox[{"SortBy", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"(", 
                   RowBox[{"#", "//", 
                    RowBox[{"Im", "&"}]}], ")"}], ",", "Greater"}], "]"}], 
                "&"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"rootvals", "=", 
             RowBox[{"DeleteElements", "[", 
              RowBox[{"rootvals", ",", "string"}], "]"}]}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"allLevelstrings", ",", "strings"}], "]"}]}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"rootsExact", "//", "Keys"}], ")"}], "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}], "//", "Max"}]}], 
         "}"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"allLevelstrings", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"SortBy", "[", 
              RowBox[{"#", ",", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "//", "Re"}], ")"}], 
                "&"}]}], "]"}], "&"}], "/@", 
            RowBox[{"GatherBy", "[", 
             RowBox[{"#", ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"#", "//", "Length"}], ")"}], "&"}]}], "]"}]}], ",", 
           "1"}], "]"}], "&"}], "/@", "allLevelstrings"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"k", "=", "0"}], ";", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"k", "++"}], ";", 
            RowBox[{
             RowBox[{"x", "[", 
              RowBox[{"a", ",", "0", ",", "k"}], "]"}], "->", 
             RowBox[{"allLevelstrings", "[", 
              RowBox[{"[", 
               RowBox[{"a", ",", "b", ",", "c"}], "]"}], "]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"b", ",", 
             RowBox[{"Length", "[", 
              RowBox[{"allLevelstrings", "[", 
               RowBox[{"[", "a", "]"}], "]"}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"c", ",", 
             RowBox[{"Length", "[", 
              RowBox[{"allLevelstrings", "[", 
               RowBox[{"[", 
                RowBox[{"a", ",", "b"}], "]"}], "]"}], "]"}]}], "}"}]}], 
          "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", 
          RowBox[{"Length", "[", "allLevelstrings", "]"}]}], "}"}]}], "]"}]}],
      ")"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Problems", ":", " ", 
      RowBox[{
      "1.", " ", "If", " ", "highest", " ", "values", " ", "deviates", " ", 
       "much", " ", "from", " ", "multiple", " ", "of", " ", 
       RowBox[{"I", "/", "2"}], " ", "or", " ", "I"}]}], ",", " ", 
     RowBox[{
     "the", " ", "guess", " ", "for", " ", "stringlength", " ", "can", " ", 
      "be", " ", "wrong"}]}], "*)"}]}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.977121650343625*^9, 3.977121742463064*^9}, 
   3.977121788600494*^9, {3.977122166544842*^9, 3.977122188851509*^9}, {
