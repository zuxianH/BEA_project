Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Creates", " ", "fused", " ", "BAE", " ", "and", " ", "counting", " ", 
    "functions"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"FusingBAE", "[", 
     RowBox[{"stringconfig_", ",", "yd_"}], "]"}], ":=", 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Q", "[", 
        RowBox[{"x_", ",", "n_"}], "]"}], ":=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "===", "0"}], "&&", 
          RowBox[{"n", "===", "0"}]}], ",", "1", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "+", 
            RowBox[{"n", " ", "I"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"x", "-", 
            RowBox[{"n", " ", "I"}]}], ")"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Qppnn", "[", 
        RowBox[{"a_", ",", "i_"}], "]"}], ":=", 
       RowBox[{"Product", "[", 
        RowBox[{
         RowBox[{"Q", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"x", "[", 
             RowBox[{"a", ",", "i"}], "]"}], "-", 
            RowBox[{"x", "[", 
             RowBox[{"a", ",", "j"}], "]"}]}], ",", "1"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", 
           RowBox[{"MM", "[", 
            RowBox[{"a", ",", "0", ",", "yd"}], "]"}]}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Apn", "[", 
        RowBox[{"a_", ",", "i_"}], "]"}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{"Product", "[", 
          RowBox[{
           RowBox[{"Q", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"x", "[", 
               RowBox[{"a", ",", "i"}], "]"}], "-", 
              RowBox[{"x", "[", 
               RowBox[{
                RowBox[{"a", "-", "1"}], ",", "j"}], "]"}]}], ",", 
             RowBox[{"1", "/", "2"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", 
             RowBox[{"MM", "[", 
              RowBox[{
               RowBox[{"a", "-", "1"}], ",", "0", ",", "yd"}], "]"}]}], 
            "}"}]}], "]"}], "/.", 
         RowBox[{
          RowBox[{"x", "[", 
           RowBox[{"0", ",", "n_"}], "]"}], ":>", 
          RowBox[{"\[Theta]", "[", "n", "]"}]}]}], "/.", 
        RowBox[{
         RowBox[{"\[Theta]", "[", "n_", "]"}], ":>", "0"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Bpn", "[", 
        RowBox[{"a_", ",", "i_"}], "]"}], ":=", 
       RowBox[{"Product", "[", 
        RowBox[{
         RowBox[{"Q", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"x", "[", 
             RowBox[{"a", ",", "i"}], "]"}], "-", 
            RowBox[{"x", "[", 
             RowBox[{
              RowBox[{"a", "+", "1"}], ",", "j"}], "]"}]}], ",", 
           RowBox[{"1", "/", "2"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", 
           RowBox[{"MM", "[", 
            RowBox[{
             RowBox[{"a", "+", "1"}], ",", "0", ",", "yd"}], "]"}]}], "}"}]}],
         "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"vargroups", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Allrelfused", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"stringgroups", "=", 
           RowBox[{"TakeList", "[", 
            RowBox[{
