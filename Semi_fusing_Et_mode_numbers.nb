   3.977141414402566*^9}, {3.9771414611653347`*^9, 3.977141464014533*^9}, {
   3.977141528745117*^9, 3.977141541597342*^9}, {3.977141681815137*^9, 
   3.977141717273614*^9}, {3.977141756770246*^9, 3.977141787005068*^9}, 
   3.9771443637795753`*^9, {3.977152822445138*^9, 3.9771528226661673`*^9}, {
   3.977300863618277*^9, 3.977301012034787*^9}, 3.977301044263137*^9, {
